# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Required: Neon Postgres connection string (users, roles, spend tracking, settings)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# The image model is NOT an env var — it lives in the settings table
# (key: image_model) and admins change it at /admin.

# Optional: self-hosted OpenRouter-compatible endpoint
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: public URL of this app, sent to OpenRouter for attribution rankings
# APP_URL=https://your-app.example.com
